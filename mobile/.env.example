# API URL — fiziksel cihazdan backend'e ulaşmak için
# "localhost" yerine bilgisayarınızın yerel ağ IP adresini yazın
# Örnek: http://192.168.1.42:3000/api/v1
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000/api/v1

# Socket.IO sunucu adresi — genellikle API URL ile aynı host, /api/v1 olmadan
# Örnek: http://192.168.1.42:3000
EXPO_PUBLIC_SOCKET_URL=http://YOUR_LOCAL_IP:3000
